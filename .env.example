# Cấu hình Server
PORT=3000
NODE_ENV=development

# Cấu hình Google Cloud Service Account
# Đường dẫn tới file credentials.json (tải từ Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ID của Thư mục Google Drive lưu file PDF
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ID của File Google Sheet ghi dữ liệu khảo sát
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Trang tính1
