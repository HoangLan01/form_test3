# Cấu hình Server
PORT=3000
NODE_ENV=production
DOMAIN=https://khaosat.phuongtungthien.vn

# Cấu hình Google Cloud Service Account (Google Sheets API)
GOOGLE_CREDENTIALS_PATH=./credentials.json
